# Path to a local sunflower-land checkout (required)
SFL_ROOT=../sunflower-land

# Protected CDN used by SUNNYSIDE / crop lifecycle URLs
PROTECTED_IMAGE_URL=https://sunflower-land.com/testnet-assets

# Where to write assets/ + metadata (relative or absolute)
OUT_DIR=.

# Optional: parallel copy/fetch workers (default 8)
# SYNC_CONCURRENCY=8
